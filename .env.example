# انسخ الملف ده باسم .env واملأ القيم عندك. ماترفعوش على GitHub.
DATABASE_URL=postgres://user:password@prod-host:5432/database
# قاعدة اختبار منفصلة تماماً (مشروع Supabase تاني) — إلزامية لـ npm test
TEST_DATABASE_URL=postgres://user:password@test-host:5432/database_test
PGSSL=true

# إنتاج بس
NODE_ENV=production
APP_ORIGIN=https://your-app-domain.example
TRUST_PROXY=1
DEVICE_HASH_SALT=change-me-to-a-long-random-value

# استرداد اختياري بالإيميل
RESEND_API_KEY=
RECOVERY_FROM_EMAIL=

# السيرفر بس — مش للعميل أبداً
SUPABASE_SERVICE_ROLE_KEY=
MODERATE_FUNCTION_URL=

# محلي بس لترقية الأدمن
ALLOW_LOCAL_ADMIN=0
